# Copy to .env.local and fill in. Never commit .env.local.
# Every variable is optional: without them, the app runs with the rule-based
# parser and a local JSON database (.data/db.json).

# --- AI (server-side only; never exposed to the browser) ---
# Groq (free tier, works in Kosovo) — key from https://console.groq.com
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Google Gemini — key from https://aistudio.google.com
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Anthropic Claude (alternative)
# AI_API_KEY=
# AI_MODEL=claude-opus-5-5
# Force a provider when several keys are set: groq | gemini | anthropic
# AI_PROVIDER=gemini

# --- Supabase (server-side only) ---
# Project URL (Supabase dashboard → Project Settings → API)
SUPABASE_URL=
# Service-role key: used only by server code. Do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# The anon key is not needed by this MVP (all DB access is server-side).
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Authentication ---
# Secret that signs session cookies (>= 16 chars). REQUIRED in production; in development a random one is kept in .data/auth-secret.
# AUTH_SECRET=
# Engineer account created automatically the first time someone signs in (use a strong password; never commit it).
# More accounts: node scripts/create-user.mjs --email you@company.com --name "Your Name" --role engineer
# ENGINEER_SEED_EMAIL=engineer@your-company.com
# ENGINEER_SEED_NAME=Your Name
# ENGINEER_SEED_PASSWORD=

# --- Company / demo data (optional) ---
# COMPANY_NAME=VEATS Electrical Engineering
# COMPANY_ADDRESS=Prishtinë, Kosovo
# COMPANY_EMAIL=offers@veats.example

# --- CAD (optional) ---
# CAD_ADAPTER=local-svg-dxf
# AUTOCAD_MCP_URL=http://127.0.0.1:8765/mcp   # AutoCAD service (integrations/autocad-mcp/start.ps1)
# VEATS_CAD_OUTPUT=      # folder for generated CAD files (default: Documents\VeatsAI\drawings)
# VEATS_UPLOAD_DIR=      # folder for uploaded plans (default: .data/uploads)
